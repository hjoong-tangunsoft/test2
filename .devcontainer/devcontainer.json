{
  "name": "MSA Training - Dev Container Test",
  "image": "mcr.microsoft.com/devcontainers/java:1-17-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.rulers": [120]
      }
    }
  },
  "forwardPorts": [8080, 8081],
  "portsAttributes": {
    "8080": {"label": "Test Service A"},
    "8081": {"label": "Test Service B"}
  },
  "containerEnv": {
    "TZ": "Asia/Seoul"
  },
  "postCreateCommand": "java -version && node --version && docker --version",
  "remoteUser": "vscode",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  }
}
